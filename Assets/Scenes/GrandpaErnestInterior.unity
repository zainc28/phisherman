--- !u!114 &510970376
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 510970375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: EmailSwiper
  returnScene: WorldMap5
  introLines:
  - speaker: NPC
    text: You made it all the way out here. These last emails are the trickiest I've
      seen.
  - speaker: Player
    text: "The ones out here are polished \u2014 real logos, real-sounding language,
      everything."
  - speaker: NPC
    text: Some don't even ask for money right away. They just want me to 'log in
      to verify'.
  - speaker: Player
    text: "That's the newest trick \u2014 steal the login, then everything else follows."
  - speaker: NPC
    text: I need your sharpest eye on this batch.
  - speaker: Player
    text: You've got it. Let's sort every last one.
  winLines:
  - speaker: NPC
    text: "You caught every last one \u2014 even the ones I was sure were real!"
  - speaker: Player
    text: 'That''s the whole game: never assume, always verify.'
  - speaker: NPC
    text: You've taught this old man well.
  - speaker: Player
    text: "You taught yourself \u2014 I just pointed out what to look for."
  loseLines:
  - speaker: NPC
    text: These last ones are clever, aren't they?
  - speaker: Player
    text: The best ones always are. Let's go again.
  - speaker: NPC
    text: I'm ready when you are.
  npcName: Grandpa Ernest
  npcSprite: {fileID: -8088512989021470314, guid: 94a92c9f30ed3454aa6f327324fb5254, type: 3}
