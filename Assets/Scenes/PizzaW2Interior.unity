--- !u!114 &616850870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 616850869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: TowerDefense
  returnScene: WorldMap2
  introLines:
  - speaker: NPC
    text: Oh! You came at the right time. My email is being swamped.
  - speaker: Player
    text: What's coming in, Nonna Bea?
  - speaker: NPC
    text: "Fake invoices from suppliers I've never heard of \u2014 but they look
      just like the real ones!"
  - speaker: Player
    text: Business invoice fraud. They flood you hoping one slips through before
      you notice.
  - speaker: NPC
    text: If my accountant pays even one of these we'll lose hundreds!
  - speaker: Player
    text: Then we need to hold them off. I'll help you block every fake before it
      reaches your accountant.
  - speaker: NPC
    text: "Please \u2014 this shop is my life's work."
  - speaker: Player
    text: Let's protect it together.
  winLines:
  - speaker: NPC
    text: Every single fake blocked! My accountant will be so relieved.
  - speaker: Player
    text: Always verify any new payment request by phone before approving it.
  - speaker: NPC
    text: "I will call every supplier directly from now on \u2014 no exceptions."
  - speaker: Player
    text: That's the rule that keeps small businesses safe.
  - speaker: NPC
    text: You're a lifesaver. Have some pizza!
  loseLines:
  - speaker: NPC
    text: Some got through! My poor accountant...
  - speaker: Player
    text: "They time these in waves to overwhelm you. Let's go again \u2014 I'll
      explain the pattern."
  - speaker: NPC
    text: Yes, please. I can't let them win.
  npcName: Nonna Bea
  npcSprite: {fileID: 7138100900622287132, guid: 3e030739bfbedca44a2c75f083da28e6, type: 3}
