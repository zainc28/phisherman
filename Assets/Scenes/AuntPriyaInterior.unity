  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: SpotDifference_W5
  returnScene: WorldMap5
  introLines:
  - speaker: NPC
    text: Glad you're here. I've got two investment platform emails that look nearly
      identical.
  - speaker: Player
    text: One's likely a clone site trying to steal login details or deposits.
  - speaker: NPC
    text: The returns promised in one look almost too good.
  - speaker: Player
    text: "That's always a red flag on its own \u2014 but let's find every difference
      between these two."
  - speaker: NPC
    text: Show me what real investment communication looks like versus a fake.
  - speaker: Player
    text: Let's compare them carefully, line by line.
  winLines:
  - speaker: NPC
    text: "Every difference found \u2014 including that fake regulatory seal!"
  - speaker: Player
    text: If a return sounds guaranteed, it's almost never real.
  - speaker: NPC
    text: I'll research any platform thoroughly before trusting it with money.
  - speaker: Player
    text: That habit alone will protect your savings.
  loseLines:
  - speaker: NPC
    text: A few of those slipped by us.
  - speaker: Player
    text: Investment scams are built to look legitimate. Let's try again.
  - speaker: NPC
    text: "Yes \u2014 this one matters too much to get wrong."
  npcName: Aunt Priya
  npcSprite: {fileID: 2429201356805377445, guid: d6bf74092c62a4b478ab69a860a600d4, type: 3}
