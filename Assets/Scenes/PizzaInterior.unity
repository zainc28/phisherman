  m_IsActive: 1
--- !u!114 &489020988
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 489020987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: SpotDifference
  returnScene: WorldMap
  introLines:
  - speaker: NPC
    text: Hey, come in! I was just about to call you.
  - speaker: Player
    text: What's up, Tony? You look stressed.
  - speaker: NPC
    text: I've got two shipping notification emails that look almost identical.
  - speaker: Player
    text: Almost identical is exactly how these scams work.
  - speaker: NPC
    text: "One must be fake, but they both look legit to me \u2014 same logo, same
      layout."
  - speaker: Player
    text: Scammers copy the visuals perfectly. The tell is always in the small details.
  - speaker: NPC
    text: Can you go through them with me and find what's off?
  - speaker: Player
    text: Absolutely. Let's compare these side by side and find every red flag.
  winLines:
  - speaker: NPC
    text: Wow, you spotted every single difference! That's impressive.
  - speaker: Player
    text: Once you know the patterns, they're not hard to catch.
  - speaker: NPC
    text: The fake sender address was a dead giveaway, right?
  - speaker: Player
    text: Exactly. Real businesses never ask for login info by email.
  - speaker: NPC
    text: I'm sharing this with my staff. Thanks a million!
  loseLines:
  - speaker: NPC
    text: Hmm, a couple of those differences tripped you up, eh?
  - speaker: Player
    text: They were pretty convincing. Want me to try again?
  - speaker: NPC
    text: Please! I need this place protected.
  npcName: Uncle Tony
  npcSprite: {fileID: -6240693553108084408, guid: c4e98b07a68a1ef44bbc323dd9ebf7eb, type: 3}
  dialoguePanel: {fileID: 83103510}
  advanceButton: {fileID: 43739844}
