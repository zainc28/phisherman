  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1746998447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1746998446}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: EmailSwiper
  returnScene: WorldMap
  introLines:
  - speaker: NPC
    text: Oh dear, you're here! Come in, come in. I've been so worried.
  - speaker: Player
    text: What's going on, Grandma?
  - speaker: NPC
    text: I keep getting emails saying my bank account is frozen!
  - speaker: Player
    text: That sounds like a phishing scam. Let me take a look.
  - speaker: NPC
    text: "Another one claims the government wants to send me a refund \u2014 but
      I need to click a link first."
  - speaker: Player
    text: Classic trick. They use urgency and fear so you act without thinking.
  - speaker: NPC
    text: My friend Margaret clicked one of those links and lost her savings...
  - speaker: Player
    text: Don't worry. I'll help you sort through these and spot every red flag.
  winLines:
  - speaker: NPC
    text: Oh my goodness! I never would have caught all of those on my own.
  - speaker: Player
    text: The key is to slow down. Scammers count on you panicking.
  - speaker: NPC
    text: I'll remember that. Always check the sender's address first, right?
  - speaker: Player
    text: "Exactly. And never click links in emails \u2014 go to the website directly."
  - speaker: NPC
    text: Thank you so much, dear. I feel much safer now!
  loseLines:
  - speaker: NPC
    text: Oh no... that wasn't quite right, was it?
  - speaker: Player
    text: "It's harder than it looks \u2014 scammers are getting very convincing."
  - speaker: NPC
    text: Could we try again? I really need to learn this.
  npcName: Grandma Rose
  npcSprite: {fileID: -7523692823116423514, guid: d5b3cc56e0201d74d8c7b3f09620ff68, type: 3}
