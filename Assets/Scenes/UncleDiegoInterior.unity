MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 892333018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: TowerDefense
  returnScene: WorldMap5
  introLines:
  - speaker: NPC
    text: "This is it \u2014 the last stretch. Every kind of scam you've seen is
      hitting me at once."
  - speaker: Player
    text: "Weak passwords, impersonators, fake links \u2014 all in one wave?"
  - speaker: NPC
    text: All of it. I need everything you've taught the others, right now.
  - speaker: Player
    text: Then let's put it all together and hold this line.
  - speaker: NPC
    text: I'm ready. Let's finish this.
  - speaker: Player
    text: Together.
  winLines:
  - speaker: NPC
    text: We held every single wave! I don't think anything could get through now.
  - speaker: Player
    text: "You've learned everything there is \u2014 weak passwords, impersonation,
      fake links, all of it."
  - speaker: NPC
    text: "Thanks to you, this harbor \u2014 and everyone in it \u2014 is safe."
  - speaker: Player
    text: You did the hard part. I just showed you where to look.
  loseLines:
  - speaker: NPC
    text: "That was a lot all at once \u2014 a few got through."
  - speaker: Player
    text: It's the toughest wave yet. Let's regroup and try again.
  - speaker: NPC
    text: Let's finish what we started.
