MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 831738741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: EmailSwiper
  returnScene: WorldMap3
  introLines:
  - speaker: NPC
    text: There you are! My phone's been buzzing all day with strange messages.
  - speaker: Player
    text: "Let me guess \u2014 texts pretending to be your mobile carrier?"
  - speaker: NPC
    text: Yes! One says my bill failed and I need to 'update payment' right now.
  - speaker: Player
    text: Classic urgency trick. Real carriers don't threaten to cut you off in an
      hour.
  - speaker: NPC
    text: There's a whole inbox of these. Can you help me sort the real from the
      fake?
  - speaker: Player
    text: Of course. Let's go through them one by one.
  winLines:
  - speaker: NPC
    text: You caught every fake one! I feel silly for almost falling for a few.
  - speaker: Player
    text: "Don't \u2014 these are designed to fool busy people. That's not silly,
      that's normal."
  - speaker: NPC
    text: I'll double check the sender before I ever click again.
  - speaker: Player
    text: That's exactly the habit that keeps you safe.
  loseLines:
  - speaker: NPC
    text: Ooh, a few of those got past us.
  - speaker: Player
    text: They're sneaky ones. Let's give it another go.
  - speaker: NPC
    text: "Please \u2014 I want to get this right."
  npcName: Aunt Carol
  npcSprite: {fileID: -6043012606051517724, guid: 391fae516c6e74b459807d172be0ed9c, type: 3}
  dialoguePanel: {fileID: 1159901773}
