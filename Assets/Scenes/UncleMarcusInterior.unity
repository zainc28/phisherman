--- !u!114 &477125114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 477125113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: TowerDefense
  returnScene: WorldMap
  introLines:
  - speaker: NPC
    text: "Hey! Perfect timing \u2014 my shop's login page keeps getting hammered."
  - speaker: Player
    text: Hammered how? Are people trying to log in as you?
  - speaker: NPC
    text: Emails, texts, all pretending to be 'account security' asking me to confirm
      my password.
  - speaker: Player
    text: That's a credential-stuffing wave. We need to hold the line and only let
      the real logins through.
  - speaker: NPC
    text: Can you help me tell strong logins from the fakes before they overwhelm
      me?
  - speaker: Player
    text: "Let's set up a defense \u2014 weak or suspicious ones get blocked, the
      real ones get through."
  winLines:
  - speaker: NPC
    text: You held them all off! My shop account is safe.
  - speaker: Player
    text: The trick is never reusing the same password across sites.
  - speaker: NPC
    text: Noted. One breach anywhere shouldn't mean a breach everywhere.
  - speaker: Player
    text: Exactly right.
  loseLines:
  - speaker: NPC
    text: A few got through the gate...
  - speaker: Player
    text: It happens. Let's tighten up and try again.
  - speaker: NPC
    text: "Let's do it \u2014 I don't want to lose this shop's account."
  npcName: Uncle Marcus
  npcSprite: {fileID: -6881917104480724425, guid: 825603d3841d72249a94145126309c3a, type: 3}
