--- !u!114 &1027471686
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1027471685}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: SpotDifference
  returnScene: WorldMap4
  introLines:
  - speaker: NPC
    text: Hey! I got two 'friend request confirmation' emails and they look the same
      to me.
  - speaker: Player
    text: One's probably a fake trying to get you to click through to a lookalike
      site.
  - speaker: NPC
    text: How can they look so close to the real thing?
  - speaker: Player
    text: "They copy the layout pixel for pixel \u2014 but small details always give
      it away."
  - speaker: NPC
    text: Walk me through spotting them?
  - speaker: Player
    text: Let's compare these two side by side and find every mismatch.
  winLines:
  - speaker: NPC
    text: "You caught every difference \u2014 even the tiny font change!"
  - speaker: Player
    text: Scammers rely on you scanning quickly instead of reading closely.
  - speaker: NPC
    text: I'll slow down and actually read these from now on.
  - speaker: Player
    text: That's really all it takes.
  loseLines:
  - speaker: NPC
    text: I think we missed one or two...
  - speaker: Player
    text: They're subtle. Let's take another pass.
  - speaker: NPC
    text: "Good \u2014 I want to get sharp at this."
  npcName: Uncle Felix
  npcSprite: {fileID: -7046387980321473424, guid: fc0343fd14480fd4fb663e6c6b6d35bc, type: 3}
