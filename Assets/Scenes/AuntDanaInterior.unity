MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1133542745}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83c90e794281e6c45a7e3be79a668332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteriorDialogueManager
  minigameScene: EmailSwiper
  returnScene: WorldMap4
  introLines:
  - speaker: NPC
    text: Oh good, you're here! My inbox is flooded with order confirmations I don't
      recognize.
  - speaker: Player
    text: "Sounds like fake shopping receipts \u2014 they usually want you to click
      a 'cancel order' link."
  - speaker: NPC
    text: Yes, exactly! Some look like real stores I actually shop at.
  - speaker: Player
    text: "That's what makes them dangerous \u2014 they borrow the branding of stores
      you trust."
  - speaker: NPC
    text: Can you help me sort my real orders from the scams?
  - speaker: Player
    text: Let's go through your inbox together.
  winLines:
  - speaker: NPC
    text: You sorted every single one correctly!
  - speaker: Player
    text: The order numbers and links are always the giveaway.
  - speaker: NPC
    text: I'll check my account directly instead of clicking email links from now
      on.
  - speaker: Player
    text: That's exactly the right instinct.
  loseLines:
  - speaker: NPC
    text: A couple of those fooled me...
  - speaker: Player
    text: They're well made. Let's try that batch again.
  - speaker: NPC
    text: "Please \u2014 I order online too often not to know this."
  npcName: Aunt Dana
  npcSprite: {fileID: -5501478296298422005, guid: f460348722aa2d94396dc67333bc41f5, type: 3}
